# API and optional same-origin hosting
HOST=127.0.0.1
PORT=4000
WEB_PORT=5174
SERVE_CLIENT=false

CLIENT_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
LOG_LEVEL=info
# Set to the actual proxy hop count only when your deployment requires it.
TRUST_PROXY_HOPS=0

# Optional absolute API origin for split deployments.
# The Vite dev and preview servers proxy /api by default.
VITE_API_ORIGIN=

# Required for signup and sign-in. Use the project URL and sb_publishable key.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Reserved for later phases.
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
