# Phase 1 API
HOST=127.0.0.1
PORT=4000
CLIENT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=info
# Set to the actual proxy hop count only when your deployment requires it.
TRUST_PROXY_HOPS=0

# Optional absolute API origin for split deployments.
# The Vite dev and preview servers proxy /api by default.
VITE_API_ORIGIN=

# Reserved for later phases. Phase 1 runs without these.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
