{
  "name": "lumaledger-ai",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": { "node": "^22.13.0 || ^24.0.0" },
  "scripts": {
    "dev": "concurrently --kill-others --names api,web \"pnpm dev:server\" \"pnpm dev:client\"",
    "dev:client": "pnpm --filter @lumaledger/client dev",
    "dev:server": "pnpm --filter @lumaledger/server dev",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --if-present test",
    "build": "pnpm -r build",
    "start": "pnpm --filter @lumaledger/server start"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^9.2.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0"
  }
}
